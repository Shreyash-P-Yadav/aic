# Copy to .env and edit. Every value here has a working default — the application
# runs end to end with NO .env file and NO API key.

# --- environment -------------------------------------------------------------
ENVIRONMENT=dev
LOG_LEVEL=INFO
LOG_JSON=false

# --- simulation --------------------------------------------------------------
SEED=20260329
SIM_START=2023-09-01
SIM_END=2026-08-31
SIM_TODAY=2026-03-29
CLOCK_MODE=backfill
# Sim-seconds per wall-second in replay mode. 43200 => 1 sim-day per 2 s.
REPLAY_SPEED=43200

# --- LLM ---------------------------------------------------------------------
# "mock" runs the entire application offline with no API key. This is the default
# and it is what the test suite and the demo use.
LLM_PROVIDER=mock
# ANTHROPIC_API_KEY=sk-ant-...
LLM_MODEL_SMALL=claude-haiku-4-5-20251001
LLM_MODEL_MID=claude-sonnet-5
LLM_COST_CAP_USD_PER_INSIGHT=0.05

# --- optional features (never required) --------------------------------------
ENABLE_DENSE_RETRIEVAL=false
ENABLE_NLI_ENTAILMENT=false

# --- api ---------------------------------------------------------------------
API_HOST=127.0.0.1
API_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
